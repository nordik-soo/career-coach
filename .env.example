# ============================================================================
# SkillBridge SSM API - environment configuration
# Copy to .env and fill in real values where placeholders exist.
# ============================================================================

# ---- Service ---------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
REQUIRE_AUTH=false
CORS_ALLOW_ORIGINS=*

# ---- PostgreSQL ------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=skillbridge
PGUSER=skillbridge
PGPASSWORD=CHANGE_ME

# ---- Session store (pre-consent staging) ----------------------------------
# 'redis' (recommended) or 'cookie' (signed payload, no infra dependency).
SESSION_STORE=redis
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_MINUTES=30
# Required when SESSION_STORE=cookie. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_COOKIE_SECRET=PLACEHOLDER_SESSION_COOKIE_SECRET

# ---- Post-consent auth tokens ---------------------------------------------
# Opaque random tokens; only the SHA-256 hash is stored in Postgres.
PROFILE_TOKEN_TTL_HOURS=720

# ---- Admin auth -----------------------------------------------------------
# Single shared key for /v1/admin/* routes (data-status, pipeline/refresh).
# Clients send: Authorization: Bearer admin:<this-key>
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_KEY=PLACEHOLDER_ADMIN_API_KEY
REQUIRE_ADMIN_AUTH=true

# ---- Anthropic (Claude Haiku) ----------------------------------------------
# Haiku 4.5 is the cheap+fast default. Override if you want even cheaper Haiku 3.5.
ANTHROPIC_API_KEY=PLACEHOLDER_ANTHROPIC_API_KEY
LLM_MODEL=claude-haiku-4-5-20251001
LLM_FALLBACK_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=600
LLM_TIMEOUT_SECONDS=30
LLM_ENABLED=true

# ---- Region scope (Sault Ste. Marie) ---------------------------------------
# SSM-only product. National region codes are not used because the system
# does not source from national feeds (Job Bank, StatCan, Census).
REGION_NAME=Sault Ste. Marie
REGION_FSAS=P6A,P6B,P6C,P0R,P0S,P5A
# Renamed 2026-07-16 from LOCAL_CITIES. SCCC ingestion-side allowlist
# ONLY — SCCC covers the Algoma District so admits Wawa/Chapleau/etc.
# into ingest. The matching engine ignores this list; the SSM-only
# v_current_job view is the market boundary.
SCCC_INGEST_LOCALITIES=Sault Ste. Marie,Sault Ste Marie,SSM,Wawa,Elliot Lake,Blind River,Chapleau

# ---- Pipeline schedule -----------------------------------------------------
PIPELINE_DAILY_HOUR_ET=6
STALE_SWEEP_NOT_SEEN_DAYS=14
# Note: the 30-day "current job" freshness window is a product invariant,
# enforced in sql/schema.sql (core.v_current_job). It is intentionally NOT
# configurable via env — changing it would change the product and requires
# a schema migration + engine_version bump.

# ----------------------------------------------------------------------------
# JOB SOURCES
# ----------------------------------------------------------------------------

# SkillBridge SSM is local-only. National sources (Job Bank, StatCan, Census)
# are not used as job feeds. NOC and OaSIS remain as reference dictionaries
# (see Reference Data section below).

# --- 1. Sault Community Career Centre job board (Tier 1, intended primary)
# Uses SCCC's public WP Job Manager endpoint. Leave SCCC_FEED_URL as the
# placeholder to use the default:
#   https://saultcareercentre.ca/jm-ajax/get_listings/
SCCC_ENABLED=false
SCCC_FEED_URL=PLACEHOLDER_SCCC_FEED_URL
SCCC_API_KEY=
SCCC_FEED_FORMAT=wp_job_manager

# --- 2. Welcome to SSM Careers (Tier 1, partner)
WELCOME_SSM_ENABLED=false
WELCOME_SSM_FEED_URL=PLACEHOLDER_WELCOME_SSM_FEED_URL

# --- 3. City of Sault Ste. Marie jobs (Tier 2, public page)
CITY_SSM_ENABLED=false
CITY_SSM_CAREERS_URL=PLACEHOLDER_CITY_SSM_CAREERS_URL

# --- 4. Partner upload bridge (CSV drop-in for SCCC / Welcome SSM / etc.)
# Filename convention encodes the partner:  sccc_2026-05-20.csv
# Each row inserts with source=<partner_name>; unmatched filenames fall
# through to source='partner_csv'.
PARTNER_CSV_ENABLED=true
PARTNER_CSV_DIR=./data/partner_uploads

# --- 5+. SSM employer career pages (Tier 2). One env per employer.
# 2 reference parsers; 9 stubs. Stubs activate when their *_URL is set AND
# their *_ENABLED is true. Parser selectors are stubbed — verify against
# the live page before enabling in production.
SAULT_AREA_HOSPITAL_ENABLED=false
SAULT_AREA_HOSPITAL_URL=PLACEHOLDER_SAULT_AREA_HOSPITAL_URL
CITY_OF_SSM_HR_ENABLED=false
CITY_OF_SSM_HR_URL=PLACEHOLDER_CITY_OF_SSM_HR_URL
ALGOMA_STEEL_ENABLED=false
ALGOMA_STEEL_URL=PLACEHOLDER_ALGOMA_STEEL_URL
SAULT_COLLEGE_CAREERS_ENABLED=false
SAULT_COLLEGE_CAREERS_URL=PLACEHOLDER_SAULT_COLLEGE_CAREERS_URL
ALGOMA_U_CAREERS_ENABLED=false
ALGOMA_U_CAREERS_URL=PLACEHOLDER_ALGOMA_U_CAREERS_URL
PUC_ENABLED=false
PUC_URL=PLACEHOLDER_PUC_URL
GROUP_HEALTH_CENTRE_ENABLED=false
GROUP_HEALTH_CENTRE_URL=PLACEHOLDER_GROUP_HEALTH_CENTRE_URL
YMCA_SSM_ENABLED=false
YMCA_SSM_URL=PLACEHOLDER_YMCA_SSM_URL
CAS_ALGOMA_ENABLED=false
CAS_ALGOMA_URL=PLACEHOLDER_CAS_ALGOMA_URL
ADSAB_ENABLED=false
ADSAB_URL=PLACEHOLDER_ADSAB_URL
SCHOOL_BOARD_ENABLED=false
SCHOOL_BOARD_URL=PLACEHOLDER_SCHOOL_BOARD_URL

# ----------------------------------------------------------------------------
# TRAINING / SKILL-IMPROVEMENT SOURCES
# ----------------------------------------------------------------------------

# --- Sault College (full-time programs + continuing ed)
SAULT_COLLEGE_ENABLED=false
SAULT_COLLEGE_PROGRAMS_URL=https://www.saultcollege.ca/programs/full-time-programs
SAULT_COLLEGE_CONTINUING_ED_URL=https://www.saultcollege.ca/explore-our-program/continuing-education

# --- Algoma University programs
ALGOMA_U_ENABLED=false
ALGOMA_U_PROGRAMS_URL=https://algomau.ca/academics/programs-of-study/

# --- Northland Adult Learning Centre (ESL, computer, essential skills)
NORTHLAND_ENABLED=false
NORTHLAND_RESOURCES_URL=PLACEHOLDER_NORTHLAND_RESOURCES_URL

# --- SCCC services / workshops (Tier 1, partner)
SCCC_SERVICES_ENABLED=false
SCCC_SERVICES_URL=PLACEHOLDER_SCCC_SERVICES_URL

# ----------------------------------------------------------------------------
# SUPPLEMENTARY SOURCES — employer enrichment, settlement services,
# knowledge/reports. PR 6A is registry-only: connectors load data but
# do not (yet) feed the matching engine.
# ----------------------------------------------------------------------------

# --- AWIC labour-market reports / dashboards (Tier 1, partner)
AWIC_ENABLED=false
AWIC_REPORTS_URL=PLACEHOLDER_AWIC_REPORTS_URL
AWIC_DATA_FEED_URL=PLACEHOLDER_AWIC_DATA_FEED_URL

# --- AWIC jobs (SEPARATE flag from AWIC reports above)
# GeoJSON endpoint used by AWIC's own portal. Public, unauthenticated,
# structured. AWIC is a PRIMARY JD source alongside SCCC — registered,
# not toggled in normal operation. Override only if AWIC publishes a
# new endpoint. Provenance: AWIC is a local aggregator; SkillBridge
# ingests AWIC's curated metadata layer only, not third-party sources
# behind the apply URLs. See sql/schema.sql (approved_job_source
# description for awic_jobs) and BREAKING.md.
AWIC_JOBS_ENABLED=false
AWIC_JOBS_FEED_URL=PLACEHOLDER_AWIC_JOBS_FEED_URL
AWIC_JOBS_FEED_FORMAT=geojson

# --- SSM coordinate bounding box (WGS84). Used by AWIC jobs ingest;
# any future geo-tagged source can reuse these bounds. Defaults set in
# config.py; env overrides go here.
# SSM_BBOX_LAT_MIN=46.4
# SSM_BBOX_LAT_MAX=46.6
# SSM_BBOX_LNG_MIN=-84.5
# SSM_BBOX_LNG_MAX=-84.2

# --- RCIP designated employer list (Tier 1, partner / federal list)
# Either an HTTP URL to a CSV/JSON feed OR a local CSV path. If both set, URL wins.
RCIP_ENABLED=false
RCIP_EMPLOYER_LIST_URL=PLACEHOLDER_RCIP_EMPLOYER_LIST_URL
RCIP_EMPLOYER_LIST_CSV=./data/rcip_employers.csv

# --- SSM Local Immigration Partnership service directory (Tier 1)
SSM_LIP_ENABLED=false
SSM_LIP_SERVICES_URL=PLACEHOLDER_SSM_LIP_SERVICES_URL

# --- Sault Chamber of Commerce business directory (Tier 2, employer enrichment)
SAULT_CHAMBER_ENABLED=false
SAULT_CHAMBER_DIRECTORY_URL=PLACEHOLDER_SAULT_CHAMBER_DIRECTORY_URL

# --- City of SSM open data / GIS (Tier 2, geographic context)
CITY_SSM_OPEN_DATA_ENABLED=false
CITY_SSM_OPEN_DATA_URL=PLACEHOLDER_CITY_SSM_OPEN_DATA_URL

# ----------------------------------------------------------------------------
# REFERENCE DATA (manual downloads to ./data/)
# ----------------------------------------------------------------------------
NOC_CSV_PATH=./data/noc_2021.csv
OASIS_SKILL_CSV=./data/oasis_skills.csv
NOC_SKILL_CSV=./data/noc_skill_mapping.csv
REGULATED_OCCUPATIONS_CSV=./data/regulated_occupations_on.csv

# ----------------------------------------------------------------------------
# Skill extraction tuning
# ----------------------------------------------------------------------------
EXTRACTION_BATCH_SIZE=20
EXTRACTION_MAX_CONCURRENCY=4
SKILL_FUZZY_THRESHOLD=0.75
MIN_EXTRACTION_CONFIDENCE=0.60

# ----------------------------------------------------------------------------
# Match engine tuning (JobMatchEngine v1.0.0)
# ----------------------------------------------------------------------------
MATCH_TOP_N_REQUIRED_SKILLS=12
MATCH_MIN_REQUIRED_SKILLS_FOR_ELIGIBILITY=3
MATCH_RECENCY_BOOST_DAYS=30
MATCH_BAND_STRONG=0.75
MATCH_BAND_GOOD=0.60
MATCH_BAND_STRETCH=0.40

# ----------------------------------------------------------------------------
# Feature flags (rollout)
# ----------------------------------------------------------------------------

# Adjacent recommendations: soft-offer the user related local roles when their
# stated target is credential-only-capped or returns no direct match. Gated to
# Redis-mode sessions; cookie-mode is unaffected regardless of this flag.
# Rollback: flip to false. The pre-AR-1 user experience is preserved (no soft
# offer, no intent dispatch, no engine call). See
# docs/adjacent-recommendations-design.md §"Activation deferral".
ADJACENCY_ACTIVATION_ENABLED=false
